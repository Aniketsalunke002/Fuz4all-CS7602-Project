#include <iostream>

#include <new>

class Node {
    public:
        Node(int x) : value(x), next(nullptr) {
        }
        Node *next;
        int value;
};

 
Node *CreateNode(int x) {
    Node *node = new Node(x);
    return node;
}

 
void DeleteNode(Node *node) {
    delete node;
}

