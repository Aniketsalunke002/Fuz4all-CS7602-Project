#include <iostream>


using namespace std;

enum {
    SINGLE,
    PICKLIST,
    MULTI_SIZE
};

const int MAX = 10;

struct Item {};
struct Drink {
    char name[MAX];
    int count;
    float cost;
};
struct DrinkPicker {
    Drink drinks[MAX];
    int numberItems;
};

class DrinksPicker
{
public:
    void getPickupItems(const Item* picklist);
private:
    DrinkPicker picker;
    Drink currentPickupItem;
};

#endif 