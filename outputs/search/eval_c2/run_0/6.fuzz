#include <iostream>
class Car {
public:
    Car()
    {
        cout << "Cars are initialized" << endl;
        speed = 0;
    }
    Car(double s)
    { speed = s; }
    double speed;
};
int main()
{
    Car car(150);                   
    car.speed = 294;             
    double kilometersPassed = -294;  
    cout << kilometersPassed << endl;
    car.speed = 130;                     
    cout << car.speed << endl;