#include <iostream>
using namespace std;
int main() {
	int num = 0;
	do {
		num++;
	} while (num < 5);
	cout << num;
	return 0;
}
 
#include <iostream>
using namespace std;
int main() {
	int num = 0;
	do {
		cout << "Enter a number between 0 and 5: ";
		cin >> num;
	} while (num < 0 || num > 5);
	cout << endl;
	return 0;
}
