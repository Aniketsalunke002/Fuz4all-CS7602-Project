#include <iostream>

#include <vector>
#include	<memory>
struct X {
public:
  X(): x{0} {}
  int x;
};
struct X *getPtr(X *x, int n);
X *X::getPtr(X *x, int n) {
  return x;
}
struct X &getRef(X x) {
  X::getPtr(&x, -1);
  assert(x.x == 0);
  return x;
}
int main() {
  using namespace std;
  vector<int> vi;
  vector<X> vx;
  vector<shared_ptr<X>> sp;
  {
    X x{1};
    getRef(getRef(x));
    getRef(x);
  }
  