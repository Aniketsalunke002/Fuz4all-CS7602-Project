#include <iostream>

class Stack {
private:
  int data[STACKLENGTH];
  int top_;
public:
  Stack() {top_=-1;}
  ~Stack() {delete [] data;}
  int isEmpty();
  int top();
  void push(int data_);
  int pop();
};
int main() {
  Stack myStack;
  while(1) {
    int choice;
    std::cout << "Stack is: " << myStack << std::endl;
	std::cout << "Press 1 to push and 2 to pop." << std::endl;
	std::cin >> choice;
    switch(choice) {
      case 1:  
        std::cout << "Give Data:" << std::endl;
        int stackdata;
        std::cin >> stackdata;
        myStack.push(stackdata);
        break;
      case 2:  
        if(myStack.isEmpty())
	std::cout << "Stack is Empty!" << std::endl;
        else
          std::cout << "Pop : " << myStack.pop()