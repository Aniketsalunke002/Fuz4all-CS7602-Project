#include <iostream>

using namespace std;

#include <string>
using namespace std;


int main() {
    string name = "Andreas";
    string fullname = "Andreas" + " " + "Davids";

    std::cout << name << " " << fullname << std::endl;
    cout << isspace(name) << isspace(fullname) << endl;
    cout << endl;

    return 0;
}
