#include <iostream>

#include <string>
#include <vector>

int main()
{
    using namespace std;

    string s;
    getline(cin, s);

    cout << "Length of s: " << s.size() << endl;
    cout << "The first character is: " << s[0] << endl;
    cout << "The last character is: " << s[s.size() - 1] << endl;

    vector<int> nums = {1, 2, 3, 4, 5};
    cout << "The first element is: " << nums[0] << endl;
    cout << "The second element is: " << nums[1] << endl;
    cout << "The third element is: " << nums[2] << endl;
    cout << "The fourth element is: " << nums[3] << endl;
    cout << "The fifth element is: " << nums[4] << endl;

    return 0;
}