#include <iostream>
#include <string>
int main() {
	std::string s = "Hello C++ World!";

	 
	std::basic_string<char> s2 = s;

	std::cout << s2.c_str() << std::endl;

	 
	std::string s3 = s;
	s3.assign("Hello C++ World!");

	s3.at(0) = 'H';
	std::cout << s3.substr(0, 2) << s3.substr(2) << std::endl;

	 
	std::basic_string<char> s4 = std::string(s);  
	std::cout << s4.c_str() << std::endl;

	return 0;
}