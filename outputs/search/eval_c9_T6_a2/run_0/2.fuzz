#include <iostream>

#include <cstdlib>
#include <vector>
using namespace std;

int main()
{
    vector<int> v;
    v.push_back(42);
    v.push_back(43);
    v.push_back(44);
    auto it = v.begin();
    cout << *it << endl;
    it++;
    cout << *it << endl;

    int i = 0;
    while(i < v.size())
    {
        cout << v[i] << endl;
        i++;
    }

    return 0;
}