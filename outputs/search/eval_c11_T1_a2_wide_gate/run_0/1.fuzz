#include <iostream>


class A {
  public:
    A() { std::cout << "A::A()\n"; }
    virtual ~A() { std::cout << "A::~A()\n"; }
};

class B : public A {
  public:
    B() { std::cout << "B::B()\n"; }
    virtual ~B() { std::cout << "B::~B()\n"; }
};

class C : public B {
  public:
    C() { std::cout << "C::C()\n"; }
};

int main() {
  C c;
  return 0;
}
