#include <iostream>

class A {
    public:
    A() { std::cout << "A::A()\n"; }
    virtual ~A() { std::cout << "A::~A()\n"; }
};
class B : public A {
    public:
    B() { std::cout << "B::B()\n"; }
    virtual ~B() { std::cout << "B::~B()\n"; }
};
class C : public B {
    public:
    C() { std::cout << "C::C()\n"; }
    virtual ~C() { std::cout << "C::~C()\n"; }
};
void A::mutate() {
    std::cout << "A::mutate()\n";
}
void B::mutate() {
    std::cout << "B::mutate()\n";
}
void C::mutate() {
    std::cout << "C::mutate()\n";
}
int main() {
    A a;
    B b;
    C c;
    a.mutate();
    b.mutate();
    c.mutate();
    return 0;
}