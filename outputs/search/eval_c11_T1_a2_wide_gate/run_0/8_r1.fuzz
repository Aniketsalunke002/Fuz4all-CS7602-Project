#include <iostream>

class A {
  public:
    A() { std::cout << "A::A()\n"; }
    virtual ~A() { std::cout << "A::~A()\n"; }
};
class B : public A {
  public:
    B() { std::cout << "B::B()\n"; }
    virtual ~B() { std::cout << "B::~B()\n"; }
};
class C : public B {
  public:
    C() { std::cout << "C::C()\n"; }
    B *a;
};
int main() {
  A a;
  B b;
  C c;
  c.a = b;
  return 0;
}