#include <iostream>

#include <string>
#include <map>
#include <set>

using std::set;
using std::map;
using std::pair;
using std::cout;
using std::endl;

int main() {
	set<int> s1;
	set<int> s2(s1);
	set<int> s3(s1.begin(), s1.end());

	set<int>::iterator it;

	for (it = s1.begin(); it!= s1.end(); ++it) {
		cout << *it << " ";
	}
	cout << endl;

	s1.insert(42);
	s2.insert(42);
	s3.insert(42);

	for (it = s1.begin(); it!= s1.end(); ++it) {
		cout << *it << " ";
	}
	cout << endl;

	return 0;
}
