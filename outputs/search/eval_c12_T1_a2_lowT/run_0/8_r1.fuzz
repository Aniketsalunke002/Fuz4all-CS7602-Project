#include <iostream>

using namespace std;
int main()
{
    int year = 2019;
    int month = 12;
    int day = 31;
    cout << "The previous year is " << year << "." << endl;
    cout << "The previous month is " << month << "." << endl;
    cout << "The previous day is " << day << "." << endl;
    return 0;
}